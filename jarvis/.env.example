# JARVIS environment template.  Copy to ".env" and edit.  NEVER commit .env.
# Anything left blank is simply not used - the app stays fully offline-capable.

# ---- Optional cloud brain (off until you add a key AND set ALLOW_CLOUD) ----
GEMINI_API_KEY=
ALLOW_CLOUD=0

# ---- Optional search provider (DuckDuckGo works with no key at all) --------
BRAVE_API_KEY=

# ---- Local model ------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# ---- Whisper ----------------------------------------------------------------
WHISPER_MODEL=tiny.en
WHISPER_LANGUAGE=en

# ---- Wake word (only if you trained/downloaded a model) -------------------
WAKE_MODEL_DIR=

# ---- Privacy ----------------------------------------------------------------
PRIVACY_MODE=0
OFFLINE_MODE=0
STORE_TRANSCRIPTS=1
